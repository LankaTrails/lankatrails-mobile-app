# Copy to .env (git-ignored). Only EXPO_PUBLIC_* variables are inlined into the app
# bundle, so never put server secrets (e.g. OAuth client secrets) here.

# Backend REST API. On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# Backend origin, used to build /uploads/... image URLs
EXPO_PUBLIC_URL=http://localhost:8080

# Google Places (place details). Restrict the key to the app's bundle ID / package.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Google Routes / Directions. NOTE: services/googleDirectionsService.ts reads this
# unprefixed name, which Expo does not inline; it will be renamed to
# EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY when hardcoded keys are removed.
EXPO_GOOGLE_DIRECTIONS_API_KEY=
