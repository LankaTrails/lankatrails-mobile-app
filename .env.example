# Copy to .env (git-ignored). Only EXPO_PUBLIC_* variables reach the app bundle, and anything in the
# bundle can be extracted, so never put server secrets (OAuth client secrets, Stripe secret keys) here.
# EAS cloud builds read the same names from eas.json / `eas env`.

# Backend REST API. On a phone use your machine's LAN IP (e.g. http://192.168.1.20:8080/api), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# Backend origin that serves /uploads/... images and the /ws chat endpoint (defaults to the API URL without /api)
EXPO_PUBLIC_URL=http://localhost:8080
# Deep-link scheme, also used as the Stripe return URL
EXPO_PUBLIC_SCHEME=lankatrailsmobileapp

# Google Maps SDK key for the native map (read by app.config.ts). Restrict it to the bundle ID / package.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Places API (search, place details, photos). Restrict to the Places API.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Google Routes / Directions API (trip map). Falls back to the Places key when empty.
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=

# Stripe publishable key (pk_test_... in development). Payments are disabled when empty.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenWeather API key for trip weather. The weather card is hidden when empty.
EXPO_PUBLIC_OPENWEATHER_API_KEY=
