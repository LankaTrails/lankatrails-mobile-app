# Normalize line endings: LF in the repo and working tree on every OS.
* text=auto eol=lf

# Windows scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
